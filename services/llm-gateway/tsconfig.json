{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "target": "es2022",
        "lib": [
            "es2022"
        ],
        "sourceMap": true,
        "outDir": "./dist",
        "baseUrl": "./",
        "ignoreDeprecations": "6.0",
        "incremental": true,
        "resolveJsonModule": true,
        "paths": {
            "@/*": [
                "src/*"
            ],
            "~*": [
                "src/*"
            ],
            "@hodfords/api-gateway": [
                "libs/api-gateway"
            ]
        },
        "skipLibCheck": true
    },
    "include": [
        "libs",
        "src",
        "test"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}