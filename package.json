{
  "name": "pavilion-mfe-monorepo",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --parallel -r --filter './apps/**' --filter './packages/**' --filter '!@pavilion-mfe/desktop' dev",
    "dev:service": "pnpm --parallel -r --filter './services/**' dev",
    "dev:desktop": "pnpm dev:web & pnpm dev:service & pnpm --filter @pavilion-mfe/desktop dev",
    "build": "pnpm -r build",
    "build:dev": "pnpm --parallel -r --filter '!@pavilion-mfe/desktop' build:dev",
    "build:desktop": "pnpm build:dev && pnpm --filter @pavilion-mfe/desktop build",
    "package:desktop": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package",
    "package:desktop:dir": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package:dir",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint -c .oxlintrc.json --disable-nested-config --deny-warnings --report-unused-disable-directives .",
    "lint:fix": "oxlint -c .oxlintrc.json --disable-nested-config --fix --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt -c .oxfmtrc.json --disable-nested-config --write .",
    "format:check": "oxfmt -c .oxfmtrc.json --disable-nested-config --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "lint:spellcheck": "cspell lint \"(packages|apps)/**/*.{js,ts,mjs,cjs,json,css,less,scss,vue,html,md}\"",
    "prepare": "husky",
    "pre-commit": "lint-staged"
  },
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "@cspell/dict-lorem-ipsum": "^4.0.5",
    "cspell": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "volta": {
    "node": "22.23.1"
  }
}
