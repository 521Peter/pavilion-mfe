{
  "name": "@pavilion-mfe/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron desktop shell for the PavilionMfe micro-frontend project",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && electron-builder --publish never",
    "package:dir": "node scripts/build.mjs && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.23.0",
    "wait-on": "^7.2.0"
  }
}
