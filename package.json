{
  "name": "pavilion-mfe-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r --filter '!@pavilion-mfe/desktop' --filter '!@pavilion-mfe/platform-api' dev",
    "dev:service": "pnpm --filter @pavilion-mfe/platform-api dev",
    "dev:desktop": "pnpm dev & pnpm --filter @pavilion-mfe/desktop dev",
    "build": "pnpm -r build",
    "build:dev": "pnpm --parallel -r --filter '!@pavilion-mfe/desktop' --filter '!@pavilion-mfe/platform-api' build:dev",
    "build:desktop": "pnpm build:dev && pnpm --filter @pavilion-mfe/desktop build",
    "package:desktop": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package",
    "package:desktop:dir": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package:dir",
    "typecheck": "pnpm -r typecheck",
    "lint:prettier": "prettier --write \"**/*.{js,ts,mjs,cjs,json,tsx,css,less,scss,vue,html,md}\""
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "volta": {
    "node": "22.23.1"
  }
}
