{
  "name": "pavilion-mfe-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r --filter '!@pavilion-mfe/desktop' dev",
    "build": "pnpm -r build",
    "build:dev":"pnpm --parallel -r --filter '!@pavilion-mfe/desktop' build:dev",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm dev & pnpm --filter @pavilion-mfe/desktop dev",
    "build:desktop": "pnpm build:dev && pnpm --filter @pavilion-mfe/desktop build",
    "package:desktop": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package",
    "package:desktop:dir": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package:dir"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "volta": {
    "node": "22.23.1"
  }
}
