{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "webpack": true,
        "assets": [
            {
                "include": "**/*.hbs",
                "watchAssets": true
            },
            {
                "include": "../libs/**/*.hbs",
                "outDir": "dist",
                "watchAssets": true
            },
            {
                "include": "../generated/prisma/**/*",
                "outDir": "dist/generated",
                "watchAssets": true
            },
            {
                "include": "statics/*",
                "watchAssets": true
            },
            {
                "include": "i18n/**/*",
                "watchAssets": true
            }
        ]
    }
}
