# ─── Platform API 配置 ───
NODE_ENV=development
PORT=3000
# ─── PostgreSQL (Docker) ───
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/pavilion_dev?schema=public"

# ─── Redis (Docker) ───
REDIS_HOST=localhost
REDIS_PORT=6380

# ─── JWT ───
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ─── Seed ───
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-local-admin-password

# ─── CORS ───
CORS_ORIGIN=http://localhost:6019

# ─── 下游服务代理（JSON 数组；无下游服务时保持空数组）───
API_SERVICES=[]

# ─── Provider Credential 加密（32 字节密钥的 base64 编码）───
CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ─── Gateway Application Key 哈希盐 ───
APPLICATION_KEY_PEPPER=replace-with-a-long-random-pepper

# 生产环境默认禁止指向私网的 Provider/MCP HTTP URL
ALLOW_PRIVATE_PROVIDER_URLS=false

# ─── OpenTelemetry（留空表示禁用 OTLP 导出）───
OTEL_SERVICE_NAME=pavilion-llm-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_MIN_DURATION_MS=0

# ─── LLM 数据面限流 ───
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_CONCURRENCY_LIMIT=10
