{
  "name": "pavilion-mfe-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:desktop": "pnpm --filter @pavilion-mfe/segment-main --filter @pavilion-mfe/demo-segment --filter @pavilion-mfe/demo-segment-react --filter @pavilion-mfe/demo-segment-vue2 --parallel dev & pnpm --filter @pavilion-mfe/desktop dev",
    "build:desktop": "pnpm --filter @pavilion-mfe/segment-main --filter @pavilion-mfe/demo-segment --filter @pavilion-mfe/demo-segment-react --filter @pavilion-mfe/demo-segment-vue2 --parallel build:dev && pnpm --filter @pavilion-mfe/desktop build",
    "package:desktop": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package",
    "package:desktop:dir": "pnpm build:desktop && pnpm --filter @pavilion-mfe/desktop package:dir"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "chalk": "^5.6.2"
  },
  "volta": {
    "node": "22.23.1"
  }
}