// PavilionMfe AI 平台 — Prisma Schema
// 数据库: PostgreSQL 16 + pgvector 扩展

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── pgvector 扩展 (RAG 向量存储) ───
// 需在数据库中执行: CREATE EXTENSION IF NOT EXISTS vector;
// Prisma 通过 Unsupported("vector") 标记 + 原生 SQL 查询使用

// ─── 用户 ───
model User {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String // bcrypt hash
  nickname  String?
  avatar    String?
  status    UserStatus @default(ACTIVE)
  roles     UserRole[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("users")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  ADMIN
  USER
}

// ─── LLM Provider 供应商 ───
model LlmProvider {
  id        String     @id @default(uuid())
  name      String // 显示名，如 "OpenAI 官方"
  type      String // 供应商类型: openai | ollama（可扩展，String 而非 enum）
  baseUrl   String? // API 地址，如 https://api.openai.com/v1 / http://localhost:11434
  apiKey    String? // API Key（加密存储）
  isActive  Boolean    @default(true) // 是否启用
  config    Json       @default("{}") // 扩展配置（headers、timeout 等）
  models    LlmModel[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("llm_providers")
}

// ─── LLM 模型 ───
model LlmModel {
  id          String      @id @default(uuid())
  providerId  String
  provider    LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  modelName   String // 模型标识，如 gpt-4o / llama3.2
  displayName String? // 展示别名
  isActive    Boolean     @default(true)
  config      Json        @default("{}") // 模型级默认参数（temperature、maxTokens 等）
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([providerId, modelName])
  @@map("llm_models")
}

// ─── MCP Server ───
model McpServer {
  id          String  @id @default(uuid())
  name        String // 显示名，如 "GitHub MCP"
  identifier  String  @unique // 唯一标识，如 "github"
  description String?
  icon        String?

  // 连接类型: stdio | http | sse
  transport String // 用 String 而非 enum，方便扩展
  command   String? // stdio: 可执行文件路径
  args      String[] @default([]) // stdio: 命令参数
  env       Json     @default("{}") // stdio: 环境变量
  url       String? // http/sse: 服务地址
  headers   Json     @default("{}") // http/sse: 请求头

  // 运行时配置
  timeout  Int     @default(60000) // 超时(ms)
  isActive Boolean @default(true)

  // 缓存：该 MCP 服务器暴露的工具列表快照
  cachedTools Json      @default("[]")
  lastSyncAt  DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("mcp_servers")
}

// ─── Skill 元数据 ───
// Skill 内容存储在文件系统（skills/<name>/ 目录）
// 数据库只记录元数据和来源信息
model Skill {
  id          String  @id @default(uuid())
  name        String  @unique // 目录名，如 "vitest"
  description String? // 从 SKILL.md frontmatter 解析

  // 来源
  source     String  @default("local") // local | remote
  repoOwner  String? // 远程：GitHub 仓库 owner
  repoName   String? // 远程：GitHub 仓库名
  repoBranch String? // 远程：分支
  readmeUrl  String? // 远程：SKILL.md 的 GitHub 链接

  // 状态
  isActive    Boolean @default(true)
  contentHash String? // 内容 hash，用于检测更新

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("skills")
}

// ─── Skill 仓库源（可拉取 skill 的远程仓库列表）───
model SkillRepo {
  id        String  @id @default(uuid())
  owner     String // GitHub owner，如 "antfu"
  name      String // GitHub repo，如 "skills"
  branch    String  @default("main")
  isEnabled Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([owner, name])
  @@map("skill_repos")
}
