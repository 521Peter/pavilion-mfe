{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "none",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "avoid",
  "proseWrap": "preserve",
  "htmlWhitespaceSensitivity": "css",
  "endOfLine": "lf",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/public/**",
    "**/.local/**",
    "**/node_modules/**",
    "pnpm-lock.yaml",
    "**/skills/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/generated/**",
    "**/.mf/**",
    "**/@mf-types/**",
    "services/llm-gateway/libs/api-gateway/views/document.hbs",
    "**/.codex/**"
  ]
}
